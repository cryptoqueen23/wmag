---
import Base from "../layouts/Base.astro";
import { publication } from "../config/publication";
---
<Base title={`Contact | ${publication.name}`} description={`Get in touch with ${publication.name}.`}>
  <article class="article">
    <header class="article-header">
      <div class="eyebrow">Contact</div>
      <h1>Get in Touch</h1>
      <p class="article-dek">Story pitches, corrections, advertising inquiries and reader letters.</p>
    </header>
    <div class="prose">
      <p><strong>Editorial:</strong> {publication.contact.editorial}</p>
      <p><strong>Advertising &amp; partnerships:</strong> {publication.contact.advertising}</p>
      <p><strong>Corrections:</strong> {publication.contact.corrections}</p>
      <p>
        Update the addresses above in <code>src/config/publication.ts</code> once a
        domain is chosen.
      </p>
    </div>
  </article>
</Base>
