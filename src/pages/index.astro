---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { publication } from "../config/publication";
import Plate from "../components/Plate.astro";
import StoryCard from "../components/StoryCard.astro";
import StoryRail from "../components/StoryRail.astro";
import PullQuote from "../components/PullQuote.astro";
import EditorialTriptych from "../components/EditorialTriptych.astro";
import PortraitFeature from "../components/PortraitFeature.astro";

const stories = (await getCollection("stories")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const hero = stories.find((s) => s.data.featured) ?? stories[0];
let pool = stories.filter((s) => s.id !== hero?.id);
const take = (n: number) => {
  const chunk = pool.slice(0, n);
  pool = pool.slice(n);
  return chunk;
};

const picks = take(4);
const triptych = take(3);
const portraitIndex = pool.findIndex((s) => s.data.contentType === "Interview");
const portrait = portraitIndex >= 0 ? pool.splice(portraitIndex, 1)[0] : pool.shift();
const rail = take(8);
const secondary = take(4);

const departmentsOf = (list: any[]) => [...new Set(list.map((s) => s.data.department))].join(", ");
---
<Base title={`${publication.name} | ${publication.tagline}`}>
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">{hero?.data.department} · {hero?.data.contentType}</div>
      <h1><a href={`/stories/${hero?.id}/`}>{hero?.data.title}</a></h1>
      <p class="dek">{hero?.data.dek}</p>
      <div class="meta">By {hero?.data.author} · {hero?.data.publishDate.toLocaleDateString("en-US",{month:"long",day:"numeric",year:"numeric"})}</div>
    </div>
    <a class="hero-image" href={`/stories/${hero?.id}/`} aria-label={hero?.data.title}>
      <Plate image={hero?.data.image} imageAlt={hero?.data.imageAlt} label={hero?.data.department ?? publication.name} />
    </a>
  </section>

  <div class="section-heading"><h2>Latest</h2></div>
  <section class="story-grid">
    {picks.map((story, i) => <StoryCard story={story} size={i === 0 ? "large" : "default"} />)}
  </section>

  {triptych.length === 3 && (
    <EditorialTriptych heading="This Week" kicker={departmentsOf(triptych)} stories={triptych as [any, any, any]} />
  )}

  <PullQuote
    quote="Traditional womanhood, done well, has never meant helplessness. It has meant competence in service of the people you love."
    attribution="From the editors"
  />

  <section class="issue-band">
    <div class="issue-kicker">The Issue</div>
    <h2>The Beauty Issue</h2>
    <p>What beauty means now: ritual, pleasure, age, style, confidence and the women redefining all of it.</p>
    <a href="/issues/beauty/">Explore the issue</a>
  </section>

  {portrait && <PortraitFeature story={portrait} />}

  {rail.length > 0 && (
    <StoryRail heading="Around the Magazine" kicker={departmentsOf(rail)} stories={rail} />
  )}

  {secondary.length > 0 && (
    <>
      <div class="section-heading"><h2>Life, Fully Lived</h2></div>
      <section class="editorial-list">
        {secondary.map((story) => (
          <article>
            <div class="eyebrow">{story.data.department}</div>
            <h3><a href={`/stories/${story.id}/`}>{story.data.title}</a></h3>
            <p>{story.data.dek}</p>
          </article>
        ))}
      </section>
    </>
  )}

  <section class="newsletter" id="newsletter">
    <div>
      <div class="eyebrow">The Letter</div>
      <h2>A smarter, more beautiful inbox.</h2>
      <p>Editors' picks, thoughtful essays, useful things and the stories women are actually talking about.</p>
    </div>
    <form>
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input id="newsletter-email" type="email" placeholder="Email address" required />
      <button type="submit">Subscribe</button>
    </form>
  </section>
</Base>
