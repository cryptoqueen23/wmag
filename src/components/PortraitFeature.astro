---
import Plate from "./Plate.astro";
interface Props {
  story: any;
}
const { story } = Astro.props;
---
<section class="portrait-feature">
  <a class="portrait-image" href={`/stories/${story.id}/`}>
    <Plate image={story.data.image} imageAlt={story.data.imageAlt} label={story.data.department} />
  </a>
  <div class="portrait-copy">
    <div class="eyebrow">{story.data.contentType}</div>
    <h2><a href={`/stories/${story.id}/`}>{story.data.title}</a></h2>
    <p class="dek">{story.data.dek}</p>
    <div class="meta">By {story.data.author}</div>
  </div>
</section>
