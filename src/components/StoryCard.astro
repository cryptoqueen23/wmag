---
import Plate from "./Plate.astro";
interface Props {
  story: any;
  size?: "default" | "large" | "small";
}
const { story, size = "default" } = Astro.props;
---
<article class:list={["card", size === "large" && "card-large", size === "small" && "card-small"]}>
  <a class="card-image" href={`/stories/${story.id}/`}>
    <Plate image={story.data.image} imageAlt={story.data.imageAlt} label={story.data.department} />
  </a>
  {size !== "small" && <div class="eyebrow">{story.data.department}</div>}
  <h3><a href={`/stories/${story.id}/`}>{story.data.title}</a></h3>
  <p>{story.data.dek}</p>
</article>
