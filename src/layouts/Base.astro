---
import "../styles/global.css";
import { publication } from "../config/publication";
import { deptSlug } from "../lib/slug";
const { title = publication.name, description = publication.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="topline">
        <span class="edition">{publication.shortName}</span>
        <div class="utility">Newsletter · Search</div>
      </div>
      <a class="masthead" href="/">{publication.name}</a>
      <nav class="main-nav" aria-label="Primary">
        {publication.nav.map((item) => (
          <a href={`/department/${deptSlug(item)}/`}>{item}</a>
        ))}
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="footer">
      <div>
        <div class="footer-mark">{publication.name}</div>
        <p>{publication.tagline}</p>
      </div>
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href={`/department/${deptSlug("Voices")}/`}>Voices</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
      </div>
    </footer>
  </body>
</html>
