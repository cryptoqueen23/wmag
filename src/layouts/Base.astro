---
import "../styles/global.css";
import { publication } from "../config/publication";
import { deptSlug } from "../lib/slug";
const { title = publication.name, description = publication.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Archivo:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="masthead-block">
      <div class="masthead-utility">
        <a class="mark" href="/" aria-label={`${publication.name} home`}>{publication.shortName}</a>
        <div class="masthead-actions">
          <a href="/#newsletter">The Letter</a>
        </div>
      </div>
      <a class="wordmark" href="/">{publication.name}</a>
      <p class="masthead-tagline">{publication.tagline}</p>
      <nav class="primary-nav" aria-label="Primary">
        {publication.nav.map((item) => (
          <a href={`/department/${deptSlug(item)}/`}>{item}</a>
        ))}
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="footer">
      <div class="footer-mark">{publication.name}</div>
      <p class="footer-tagline">{publication.tagline}</p>
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href={`/department/${deptSlug("Voices")}/`}>Voices</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy</a>
      </div>
    </footer>
  </body>
</html>
